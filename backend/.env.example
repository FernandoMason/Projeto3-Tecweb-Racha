DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
# gemini-2.5-flash nao funciona com chave nova; o flash-lite responde em poucos segundos
GEMINI_MODEL=gemini-3.5-flash-lite
# menor que o timeout do gunicorn (use --timeout 60 no deploy), para a falha da IA virar o plano B
GEMINI_TIMEOUT_MS=20000
